<% content_for :title, t(".title") %>
<main class="wrap">
  <%= render "shared/header" %>
  <header class="entry-head">
    <p class="eyebrow"><%= t(".title") %> · <%= @survey.target_code %></p>
    <h1 class="display"><%= @survey.display_name %></h1>
    <span class="pill is-<%= @survey.status_open? ? "pending" : "accepted" %>"><%= t("surveys.statuses.#{@survey.status}") %></span>
  </header>
  <% done, goal = @survey.progress %>
  <progress class="progress" value="<%= done %>" max="<%= goal %>"><%= done %>/<%= goal %></progress>
  <dl class="facts facts--row">
    <div><dt><%= t(".residents") %></dt><dd><%= done %> / <%= goal %></dd></div>
    <div><dt><%= t(".recognition") %></dt><dd><%= @survey.recognition ? number_to_percentage(@survey.recognition * 100, precision: 0) : "–" %></dd></div>
    <div><dt><%= t(".buildings") %></dt><dd><%= @survey.report["buildings_confirmed"] %></dd></div>
  </dl>

  <p class="eyebrow"><%= t(".names_heard") %></p>
  <% if @survey.names_heard.empty? %>
    <p class="sub"><%= t(".no_names") %></p>
  <% else %>
    <ul class="tally">
      <% @survey.names_heard.each do |name, count| %><li><strong><%= name %></strong> <span><%= count %></span></li><% end %>
    </ul>
  <% end %>

  <% if @survey.status_open? %>
    <p class="eyebrow"><%= t(".add") %></p>
    <% if @survey.done? %><p class="sub"><%= t(".done") %></p><% end %>
    <%= form_with model: [ @survey, @response ], url: survey_responses_path(@survey), class: "stack resident" do |f| %>
      <div>
        <%= f.label :address, t(".address"), class: "label" %>
        <%= f.text_field :address, class: "field", placeholder: "#{@survey.target_code} 1CC 17", autocapitalize: "characters", autocomplete: "off" %>
        <p class="hint"><%= t(".address_hint") %></p>
      </div>
      <fieldset class="choices">
        <legend class="label"><%= t(".recognises", name: @survey.display_name) %></legend>
        <label class="choice"><%= f.radio_button :recognises, true, required: true %><span><%= t(".agrees") %></span></label>
        <label class="choice"><%= f.radio_button :recognises, false %><span><%= t(".disagrees") %></span></label>
      </fieldset>
      <div>
        <%= f.label :calls_it, t(".calls_it"), class: "label" %>
        <%= f.text_field :calls_it, class: "field", maxlength: 80, autocomplete: "off" %>
      </div>
      <div>
        <%= f.label :note, t(".note"), class: "label" %>
        <%= f.text_field :note, class: "field", maxlength: 280 %>
      </div>
      <div class="actions">
        <%= f.submit t(".record"), class: "btn" %>
        <%= button_to t(".close"), close_survey_path(@survey), method: :patch, class: "btn btn--ghost", form: { data: { turbo_confirm: t(".close") + "?" } } %>
      </div>
    <% end %>
  <% end %>

  <p class="eyebrow"><%= t(".report") %></p>
  <div class="actions">
    <%= link_to t(".fixture"), fixture_survey_path(@survey), class: "btn btn--ghost" %>
  </div>
  <p class="hint"><%= t(".fixture_hint") %></p>

  <% if @responses.any? %>
    <ul class="entries">
      <% @responses.each do |r| %>
        <li class="entry is-<%= r.recognises ? "accepted" : "rejected" %>">
          <div class="entry-card">
            <span class="entry-main">
              <strong class="entry-label"><%= r.building ? r.building.address : (r.address || "—") %></strong>
              <span class="entry-kind"><%= r.calls_it.presence || "…" %><% if r.note.present? %> · <%= r.note %><% end %></span>
            </span>
            <span class="entry-side">
              <span class="pill is-<%= r.recognises ? "accepted" : "rejected" %>"><%= r.recognises ? t(".agrees") : t(".disagrees") %></span>
              <time class="entry-when"><%= l(r.created_at, format: :short) %> · <%= t(".recorded_by", name: r.recorded_by.name) %></time>
            </span>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="sub"><%= t(".no_responses") %></p>
  <% end %>
</main>
