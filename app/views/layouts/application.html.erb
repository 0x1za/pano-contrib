<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "pano" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#022EAC">
    <%# pano's mark, same files as the pano map. %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# One hand-written stylesheet, pano's palette; /styleguide is the reference. %>
    <%= stylesheet_link_tag "maplibre-gl" %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= content_for(:body_class) %>">
    <%# Flash as a toast; the map page keeps the header out of the way. %>
    <% if flash.any? %>
      <div class="flash<%= " is-error" if flash[:alert] %>" role="status"><%= flash[:notice] || flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
