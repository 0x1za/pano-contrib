<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-offline="<%= feature?(:offline_map) ? 1 : 0 %>">
  <head>
    <title><%= content_for(:title) || "pano" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#022EAC">
    <%# pano's mark, same files as the pano map. %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# One hand-written stylesheet, pano's palette; /styleguide is the reference. %>
    <link rel="preconnect" href="https://tile.openstreetmap.org">
    <link rel="preconnect" href="https://fonts.openmaptiles.org">
    <%= inline_app_css %>
    <%= javascript_importmap_tags %>
    <%# After the import map: a module preloaded before it cannot resolve its bare imports. %>
    <%= yield :head %>
  </head>
  <body class="<%= content_for(:body_class) %>">
    <%# Flash as a toast; the map page keeps the header out of the way. %>
    <% if flash.any? && !content_for?(:flash_handled) %>
      <div class="flash<%= " is-error" if flash[:alert] %>" role="status"><%= flash[:notice] || flash[:alert] %></div>
    <% end %>
    <%= yield %>
    <%# Contribution forms open here, over whatever page is behind, when a link targets the "modal" frame. %>
    <dialog id="contribution-modal" class="modal panel" data-controller="modal" data-action="close->modal#closed">
      <button type="button" class="modal-close" data-action="modal#close" aria-label="<%= t("shared.modal.close") %>">×</button>
      <%= turbo_frame_tag "modal", data: { action: "turbo:frame-load->modal#open" } %>
    </dialog>
  </body>
</html>
