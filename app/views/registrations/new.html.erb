<% content_for :title, t(".title") %>
<main class="wrap">
  <%= render "shared/header" %>
  <p class="eyebrow"><%= t(".eyebrow") %></p>
  <h1 class="display"><%= t(".title") %></h1>
  <p class="sub"><%= t(".why") %></p>
  <%= form_with model: @user, url: registration_path, class: "stack" do |form| %>
    <% if @user.errors.any? %>
      <div class="flash is-error is-inline"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>
    <div>
      <%= form.label :display_name, t(".display_name"), class: "label" %>
      <%= form.text_field :display_name, maxlength: 40, autocomplete: "nickname", class: "field" %>
      <p class="hint"><%= t(".display_name_hint") %></p>
    </div>
    <div>
      <%= form.label :email_address, t(".email"), class: "label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "field" %>
    </div>
    <div>
      <%= form.label :password, t(".password"), class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>
    <div>
      <%= form.label :password_confirmation, t(".password_confirmation"), class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>
    <div class="actions">
      <%= form.submit t(".submit"), class: "btn" %>
      <%= link_to t(".have_account"), new_session_path, class: "btn btn--ghost" %>
    </div>
  <% end %>
</main>
