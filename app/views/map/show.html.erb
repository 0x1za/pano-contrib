<% content_for :body_class, "is-map" %>
<% content_for :head do %>
  <%# The map page, and only the map page, needs MapLibre: say so before the parser finds out. %>
  <link rel="modulepreload" href="<%= asset_path("maplibre-gl.js") %>">
  <link rel="modulepreload" href="<%= asset_path("controllers/map_controller.js") %>">
  <%= stylesheet_link_tag "maplibre-gl" %>
  <link rel="dns-prefetch" href="https://server.arcgisonline.com">
  <%# The two answers the map asks for first, fetched before any script runs. %>
  <link rel="preload" href="/api/districts" as="fetch" crossorigin>
  <link rel="preload" href="/api/meta" as="fetch" crossorigin>
<% end %>
<div data-controller="map" data-map-api-value="<%= @api_url %>" data-map-satellite-value="<%= @satellite_tiles %>" data-map-tiles-value="<%= feature?(:offline_map) %>">
  <div class="map" data-map-target="canvas" role="application" aria-label="<%= t(".map_label") %>"></div>

  <header class="bar">
    <span class="offline-pill" data-map-target="offline" hidden></span>
    <%= link_to root_path, class: "wordmark" do %>
      <%= render "shared/mark" %>pano
    <% end %>
    <select class="town" data-map-target="town" data-action="change->map#town" aria-label="<%= t(".town") %>" title="<%= t(".town") %>" hidden></select>
    <form class="search" role="search" autocomplete="off" data-action="submit->map#search">
      <input type="text" name="q" data-map-target="query" placeholder="<%= t(".search_placeholder") %>" aria-label="<%= t(".search_placeholder") %>" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="map-suggest" data-action="input->map#suggest keydown->map#searchKey focus->map#suggest">
      <button type="submit" class="go" aria-label="<%= t(".search_go") %>">→</button>
      <ul class="suggest" id="map-suggest" role="listbox" data-map-target="suggest" data-action="click->map#pick"></ul>
    </form>
    <nav>
      <%# These open over the map, in the same dialog as the forms, so the map stays underneath. %>
      <%= link_to t(".about"), about_path, data: { turbo_frame: "modal" } %>
      <%= link_to t(".leaderboard"), leaderboard_path, data: { turbo_frame: "modal" } %>
      <% if current_user %>
        <%# Signed in, your name is your contributions. %>
        <%= link_to current_user.name, contributions_path, class: "who", data: { turbo_frame: "modal" }, title: t(".mine") %>
        <%= button_to session_path, method: :delete, class: "icon-btn", title: t("shared.header.sign_out"), "aria-label": t("shared.header.sign_out") do %>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4H5.5A1.5 1.5 0 0 0 4 5.5v13A1.5 1.5 0 0 0 5.5 20H10"/><path d="M15 16l4-4-4-4"/><path d="M19 12H9"/></svg>
        <% end %>
      <% else %>
        <%= link_to t(".mine"), contributions_path, data: { turbo_frame: "modal" } %>
        <%= link_to t("shared.header.sign_in"), new_session_path, class: "sign-in" %>
      <% end %>
      <button type="button" class="outbox" data-controller="outbox" data-action="click->outbox#send" title="<%= t(".outbox_title") %>" hidden><span data-outbox-target="count"></span></button>
      <button type="button" class="help" data-action="map#welcome" title="<%= t(".help") %>" aria-label="<%= t(".help") %>">?</button>
    </nav>
  </header>

  <%# First visit: what this is and what a tap does, as a modal. Dismissal is remembered per browser. %>
  <dialog class="modal welcome" data-map-target="welcome" data-action="click->map#welcomeBackdrop">
    <div class="card">
      <p class="eyebrow"><%= t(".welcome_eyebrow") %></p>
      <p class="address"><%= t(".welcome_title") %></p>
      <p class="lede"><%= t(".welcome_body_html") %></p>
      <ul class="how">
        <li><%= t(".how_building_html") %></li>
        <li><%= t(".how_district_html") %></li>
        <li><%= t(".how_review_html") %></li>
        <li><%= t(".how_pins_html") %></li>
      </ul>
      <div class="actions">
        <button type="button" class="btn" data-action="map#dismiss"><%= t(".welcome_go") %></button>
        <%= link_to t(".welcome_more"), about_path, class: "btn btn--ghost", data: { turbo_frame: "modal", action: "map#dismiss" } %>
      </div>
      <p class="note"><em><%= t(".bemba") %></em><% if @gazetteer %> · <%= t(".version", version: @gazetteer.version, districts: @gazetteer.places.tier_district.count) %><% end %></p>
    </div>
  </dialog>

  <% unless @gazetteer %>
    <aside class="card">
      <p class="eyebrow">pano</p>
      <p class="note"><%= t("contributions.no_gazetteer") %></p>
    </aside>
  <% end %>
</div>
