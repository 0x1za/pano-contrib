<% content_for :body_class, "is-map" %>
<div data-controller="map" data-map-api-value="<%= @api_url %>">
  <div class="map" data-map-target="canvas" role="application" aria-label="<%= t(".map_label") %>"></div>

  <header class="bar">
    <%= link_to root_path, class: "wordmark" do %>
      <%= render "shared/mark" %>pano
    <% end %>
    <nav>
      <%= link_to t(".about"), about_path %>
      <%= link_to t(".mine"), contributions_path %>
      <button type="button" class="help" data-action="map#welcome" title="<%= t(".help") %>" aria-label="<%= t(".help") %>">?</button>
    </nav>
  </header>

  <%# First visit: what this is and what a tap does. Dismissal is remembered per browser. %>
  <aside class="card welcome" data-map-target="welcome" hidden>
    <p class="eyebrow"><%= t(".welcome_eyebrow") %></p>
    <p class="address"><%= t(".welcome_title") %></p>
    <p class="lede"><%= t(".welcome_body_html") %></p>
    <ul class="how">
      <li><%= t(".how_building_html") %></li>
      <li><%= t(".how_district_html") %></li>
      <li><%= t(".how_review_html") %></li>
      <li><%= t(".how_pins_html") %></li>
    </ul>
    <div class="actions">
      <button type="button" class="btn" data-action="map#dismiss"><%= t(".welcome_go") %></button>
      <%= link_to t(".welcome_more"), about_path, class: "btn btn--ghost" %>
    </div>
    <p class="note"><em><%= t(".bemba") %></em></p>
  </aside>

  <aside class="card" data-map-target="card" hidden>
    <p class="eyebrow" data-map-target="eyebrow"></p>
    <p class="address" data-map-target="address"></p>
    <div class="actions" data-map-target="actions"></div>
    <p class="note" data-map-target="note"></p>
  </aside>

  <% unless @gazetteer %>
    <aside class="card">
      <p class="eyebrow">pano</p>
      <p class="note"><%= t("contributions.no_gazetteer") %></p>
    </aside>
  <% end %>
</div>
