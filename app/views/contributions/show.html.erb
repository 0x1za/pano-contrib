<% content_for :title, t(".title") %>
<%# Also rendered inside the map's modal frame; the frame tag is harmless on a full page. %>
<%= turbo_frame_tag "modal" do %>
<main class="wrap">
  <%= render "shared/header" %>
  <%# The confirmation lives inside the frame so it shows in the modal too; the layout's toast is skipped. %>
  <% content_for :flash_handled, "1" %>
  <% if flash[:notice] %><div class="flash is-inline is-success" role="status"><%= flash[:notice] %></div><% end %>
  <p class="eyebrow"><%= t("contributions.kinds.#{@contribution.kind}") %> · <%= t("contributions.statuses.#{@contribution.status}") %></p>
  <h1 class="display"><%= @contribution.target_label %></h1>
  <dl class="facts">
    <% if @contribution.name %><div><dt><%= t(".name") %></dt><dd><%= @contribution.name %></dd></div><% end %>
    <% if @contribution.reason %><div><dt><%= t(".reason") %></dt><dd><%= t("contributions.reasons.#{@contribution.reason}") %></dd></div><% end %>
    <% if @contribution.payload["note"] %><div><dt><%= t(".note") %></dt><dd><%= @contribution.payload["note"] %></dd></div><% end %>
    <% if @contribution.sub_address %><div><dt><%= t(".sub") %></dt><dd><%= @contribution.sub_address %></dd></div><% end %>
    <% if @contribution.homes %><div><dt><%= t(".homes") %></dt><dd><%= @contribution.homes %><% if @contribution.payload["labelling"].present? %> · <%= @contribution.payload["labelling"] %><% end %></dd></div><% end %>
    <div><dt><%= t(".sent") %></dt><dd><%= l(@contribution.created_at, format: :short) %></dd></div>
    <div><dt><%= t(".gazetteer") %></dt><dd>v<%= @contribution.gazetteer_version.version %></dd></div>
    <% if @contribution.review_note.present? %><div><dt><%= t(".review_note") %></dt><dd><%= @contribution.review_note %></dd></div><% end %>
  </dl>
  <% if @contribution.status_pending? %>
    <p class="sub"><%= t(".thanks") %></p>
    <%= render "contributions/vote", contribution: @contribution %>
  <% end %>
  <div class="actions">
    <%= link_to t(".back_to_map"), root_path, class: "btn", data: { turbo_frame: "_top" } %>
    <%= link_to t(".all_mine"), contributions_path, class: "btn btn--ghost", data: { turbo_frame: "_top" } %>
  </div>
</main>
<% end %>
