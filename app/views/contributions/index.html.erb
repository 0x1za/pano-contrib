<% content_for :title, t(".title") %>
<%= turbo_frame_tag "modal" do %>
<main class="wrap">
  <%= render "shared/header" %>
  <p class="eyebrow"><%= t(".eyebrow") %></p>
  <h1 class="display"><%= t(".title") %></h1>
  <% if (stats = current_user&.stats || Current.device&.stats) && @contributions.any? %>
    <dl class="facts facts--row">
      <div><dt><%= t(".accepted") %></dt><dd><%= stats[:accepted] %></dd></div>
      <div><dt><%= t(".votes_cast") %></dt><dd><%= stats[:votes] %></dd></div>
      <% if current_user %><div><dt><%= t(".reputation") %></dt><dd><%= current_user.reputation %></dd></div><% end %>
    </dl>
    <%= render "shared/badges", stats: stats, compact: true %>
  <% end %>
  <% if @contributions.empty? %>
    <p class="sub"><%= t(".empty") %></p>
  <% else %>
    <ul class="entries">
      <% @contributions.each do |c| %>
        <li class="entry is-<%= c.status %>">
          <%= link_to contribution_path(c) do %>
            <span class="entry-main">
              <strong class="entry-label"><%= c.target_label %></strong>
              <span class="entry-kind"><%= t("contributions.kinds.#{c.kind}") %><% if c.name || c.reason %> · <%= c.name || t("contributions.reasons.#{c.reason}") %><% end %></span>
            </span>
            <span class="entry-side">
              <span class="pill is-<%= c.status %>"><%= t("contributions.statuses.#{c.status}") %></span>
              <time class="entry-when" datetime="<%= c.created_at.iso8601 %>"><%= time_ago_in_words(c.created_at) %> <%= t(".ago") %></time>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <div class="actions"><%= link_to t(".back_to_map"), root_path, class: "btn", data: { turbo_frame: "_top" } %></div>
</main>
<% end %>
