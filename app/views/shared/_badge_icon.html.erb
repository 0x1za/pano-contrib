<%# One icon per badge, drawn on a 24-unit grid in pano's line style: 1.75
    strokes, round joins, the amber dot for "a home", cobalt for the map.
    Colour comes from the parent via currentColor so the same drawing reads
    earned or not. %>
<svg class="icon icon--<%= key %>" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<% case key.to_sym %>
<% when :pano %>
  <rect x="3.5" y="3.5" width="17" height="17" rx="3"/>
  <circle cx="12" cy="12" r="3" fill="var(--amber)" stroke="none"/>
<% when :street %>
  <rect x="2.5" y="8.5" width="5.5" height="7" rx="1.2"/>
  <rect x="9.25" y="8.5" width="5.5" height="7" rx="1.2"/>
  <rect x="16" y="8.5" width="5.5" height="7" rx="1.2"/>
  <path d="M2.5 19.5h19"/>
<% when :block %>
  <rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.5"/>
  <rect x="13" y="3.5" width="7.5" height="7.5" rx="1.5"/>
  <rect x="3.5" y="13" width="7.5" height="7.5" rx="1.5"/>
  <rect x="13" y="13" width="7.5" height="7.5" rx="1.5" fill="currentColor" fill-opacity=".18"/>
<% when :compound %>
  <rect x="3" y="3" width="5" height="5" rx="1.2"/><rect x="9.5" y="3" width="5" height="5" rx="1.2"/><rect x="16" y="3" width="5" height="5" rx="1.2"/>
  <rect x="3" y="9.5" width="5" height="5" rx="1.2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1.2" fill="currentColor" fill-opacity=".18"/><rect x="16" y="9.5" width="5" height="5" rx="1.2"/>
  <rect x="3" y="16" width="5" height="5" rx="1.2"/><rect x="9.5" y="16" width="5" height="5" rx="1.2"/><rect x="16" y="16" width="5" height="5" rx="1.2"/>
<% when :sharp_eyes %>
  <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/>
  <circle cx="12" cy="12" r="3"/>
  <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>
<% when :caretaker %>
  <path d="M5 20.5V6.5l7-3 7 3v14"/>
  <path d="M3 20.5h18"/>
  <path d="M8.5 9.5h2M13.5 9.5h2M8.5 13h2M13.5 13h2"/>
  <path d="M10.5 20.5v-4h3v4"/>
<% when :courier %>
  <path d="M3 8.5l9-4 9 4-9 4z"/>
  <path d="M3 8.5v8l9 4 9-4v-8"/>
  <path d="M12 12.5v8"/>
  <path d="M7.5 6.5l9 4" stroke-dasharray="1 2.5"/>
<% when :explorer %>
  <circle cx="12" cy="12" r="9"/>
  <path d="M15.5 8.5l-2 5-5 2 2-5z" fill="currentColor" fill-opacity=".18"/>
  <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>
<% when :regular %>
  <rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/>
  <path d="M3.5 9.5h17M8 3.5v3M16 3.5v3"/>
  <circle cx="8" cy="13.5" r=".9" fill="currentColor" stroke="none"/>
  <circle cx="12" cy="13.5" r=".9" fill="currentColor" stroke="none"/>
  <circle cx="16" cy="13.5" r=".9" fill="currentColor" stroke="none"/>
  <circle cx="8" cy="17" r=".9" fill="currentColor" stroke="none"/>
<% when :second_opinion %>
  <path d="M4 5.5h16v10H10l-4 3.5v-3.5H4z"/>
  <path d="M9 10.5l2 2 4-4"/>
<% when :referee %>
  <path d="M12 3.5v17"/>
  <path d="M5 8h14"/>
  <path d="M5 8l-2.5 6a2.75 2.75 0 0 0 5 0z"/>
  <path d="M19 8l-2.5 6a2.75 2.75 0 0 0 5 0z"/>
  <path d="M8.5 20.5h7"/>
<% when :founder %>
  <path d="M6 21V3.5"/>
  <path d="M6 4.5h11l-2.5 3.5 2.5 3.5H6z" fill="currentColor" fill-opacity=".18"/>
<% end %>
</svg>
