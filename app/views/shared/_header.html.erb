<header class="site-header">
  <%= link_to root_path, class: "wordmark" do %><%= render "shared/mark" %>pano<% end %>
  <nav>
    <%= link_to t("shared.header.mine"), contributions_path %>
    <% if current_user %>
      <%= link_to t("shared.header.review"), review_path if current_user.reviewer? %>
      <%= button_to t("shared.header.sign_out"), session_path, method: :delete, class: "linklike" %>
    <% else %>
      <%= link_to t("shared.header.sign_in"), new_session_path %>
    <% end %>
  </nav>
</header>
